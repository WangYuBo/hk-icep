---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us" lang="en" path="about/" active="about">
  <div class="container section prose">
    <h1>About Us</h1>
    <p>
      International Culture &amp; Education Press (Hong Kong) Co., Limited (ICEP) is a
      publishing house incorporated in Hong Kong as a body corporate. Our business covers
      publishing and distribution, rights and licensing agency, film and television
      production, cultural investment, and international cultural exchange.
    </p>

    <h2>What We Do</h2>
    <ul>
      <li><strong>Publishing &amp; distribution</strong> — scholarly monographs, textbooks and teaching materials, and titles in culture and the arts</li>
      <li><strong>Rights &amp; licensing</strong> — outbound and inbound licensing of Chinese-language titles</li>
      <li><strong>Film &amp; television production</strong> — screen adaptation and operation of book content</li>
      <li><strong>Cultural investment &amp; international exchange</strong> — planning and delivery of cross-cultural programmes</li>
    </ul>

    <h2>What We Publish</h2>
    <!-- TODO(before launch): placeholder subject areas — replace with the press's actual list -->
    <ul>
      <li>Humanities — philosophy, history, literature, and religious studies</li>
      <li>Social sciences — politics, economics, and society</li>
      <li>Education — educational theory, vocational education, and language teaching</li>
      <li>Culture and the arts — calligraphy, traditional culture, and intangible cultural heritage</li>
    </ul>

    <h2>Submissions &amp; Partnerships</h2>
    <p>
      We welcome proposals for monographs, textbooks, translations, and cultural exchange
      programmes. Please send a brief prospectus and CV to
      <a href="mailto:info@kfbook.org">info@kfbook.org</a>.
    </p>
  </div>
</BaseLayout>
